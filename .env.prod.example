# ===================================================================
# ReFind Backend - Production Environment Template (.env.prod.example)
# Copy to `.env.prod` or `.env` and configure with your production credentials
# ===================================================================

# 1. Server Configuration
PORT=8085

# 2. PostgreSQL Database Configuration (Managed PostgreSQL with SSL)
DB_HOST=your-production-db-host.com
DB_PORT=5432
DB_NAME=refind_db
DB_USER=refind_admin
DB_PASSWORD=your_secure_db_password_here
SSL_MODE=require
DB_POOL_MIN_IDLE=4
DB_POOL_MAX_SIZE=20

# 3. Hibernate & Flyway
FLYWAY_ENABLED=true
HIBERNATE_DDL_AUTO=validate
HIBERNATE_SHOW_SQL=false

# 4. Redis Configuration (Upstash Redis TCP over TLS)
# Format: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=rediss://default:your_upstash_password_here@your-db.upstash.io:6379
REDIS_SSL_ENABLED=true

# 5. Local Media / Storage Configuration
UPLOAD_DIR=/var/data/refind/uploads
UPLOAD_ITEMS_DIR=items
UPLOAD_AVATARS_DIR=avatars
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=30MB
MULTIPART_TMP_DIR=/tmp

# 6. Security & JWT Configuration (Generate secure 256/512-bit key)
JWT_SECRET=generate_a_random_secure_key_with_at_least_256_bits_length
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
API_KEY=
CORS_ALLOWED_ORIGIN_PATTERNS=https://refind.shariarunix.me,https://*.refind.shariarunix.me
APP_ADMIN_BOOTSTRAP_EMAILS=admin@refind.app

# 7. OTP Verification Configuration
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# 8. Firebase Cloud Messaging (FCM) Configuration
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_CONFIG_JSON=
FIREBASE_CLIENT_API_KEY=

# 9. Resend Email Delivery Configuration (Live Resend API)
RESEND_DEV_MODE=false
RESEND_API_KEY=re_your_live_resend_api_key_here
RESEND_API_URL=https://api.resend.com
RESEND_FROM_EMAIL=no-reply@refind.shariarunix.me
RESEND_FROM_NAME=ReFind

# 10. Logging
LOG_LEVEL=INFO
