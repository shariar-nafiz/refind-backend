# ===================================================================
# ReFind Backend - Development Environment Template (.env.dev.example)
# Copy to `.env.dev` or `.env` for local offline development
# ===================================================================

# 1. Server Configuration
PORT=8085

# 2. PostgreSQL Database Configuration (Local Docker matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5437
DB_NAME=refind_db
DB_USER=refind
DB_PASSWORD=refind
SSL_MODE=disable
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10

# 3. Hibernate & Flyway
FLYWAY_ENABLED=true
HIBERNATE_DDL_AUTO=validate
HIBERNATE_SHOW_SQL=true

# 4. Redis Configuration (Local Redis matches docker-compose.yml)
REDIS_URL=redis://localhost:6384
REDIS_SSL_ENABLED=false

# 5. Local Media / Storage Configuration
UPLOAD_DIR=./uploads
UPLOAD_ITEMS_DIR=items
UPLOAD_AVATARS_DIR=avatars
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=30MB
MULTIPART_TMP_DIR=/tmp

# 6. Security & JWT Configuration
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
API_KEY=
CORS_ALLOWED_ORIGIN_PATTERNS=*
APP_ADMIN_BOOTSTRAP_EMAILS=admin@refind.app

# 7. OTP Verification Configuration
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# 8. Firebase Cloud Messaging (FCM) Configuration
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_CONFIG_JSON=
FIREBASE_CLIENT_API_KEY=

# 9. Resend Email Delivery Configuration (Dev Mode: OTPs logged to console)
RESEND_DEV_MODE=true
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_API_URL=https://api.resend.com
RESEND_FROM_EMAIL=no-reply@refind.shariarunix.me
RESEND_FROM_NAME=ReFind Dev

# 10. Logging
LOG_LEVEL=DEBUG
