# ===================================================================
# ReFind Backend - Environment Variables Configuration Template
# Copy this file to `.env` and configure your local environment
# ===================================================================

# Server Configuration
PORT=8085

# PostgreSQL Database Configuration (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5437
DB_NAME=refind_db
DB_USER=refind
DB_PASSWORD=refind
SSL_MODE=disable
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=15

# Hibernate & Flyway
FLYWAY_ENABLED=true
HIBERNATE_DDL_AUTO=validate
HIBERNATE_SHOW_SQL=false

# Redis (Local Docker on port 6384 / Upstash)
# For local docker: redis://localhost:6384
# For Upstash: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6384
REDIS_SSL_ENABLED=false

# Local Media / Storage Configuration
UPLOAD_DIR=./uploads
UPLOAD_ITEMS_DIR=items
UPLOAD_AVATARS_DIR=avatars
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=30MB
MULTIPART_TMP_DIR=/tmp

# Security & JWT (Generate a secure 256-bit or 512-bit key for production)
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
API_KEY=
CORS_ALLOWED_ORIGIN_PATTERNS=*
APP_ADMIN_BOOTSTRAP_EMAILS=admin@refind.app

# Firebase Cloud Messaging (FCM) Configuration
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_CONFIG_JSON=
FIREBASE_CLIENT_API_KEY=

# Resend Email Delivery Configuration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_API_URL=https://api.resend.com
RESEND_FROM_EMAIL=no-reply@refind.app
RESEND_FROM_NAME=ReFind

# Logging
LOG_LEVEL=INFO
